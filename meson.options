# SPDX-License-Identifier: Apache-2.0

option('tests', type: 'feature', description: 'Build tests')

option(
    'create-dump-dbus',
    type: 'feature',
    value: 'enabled',
    description: 'Tool allows the service user create a dump via dbus',
)

option(
    'nsm-dump-tool',
    type: 'feature',
    value: 'disabled',
    description: 'Wrapper tool around the NSM APIs for debug logs collection',
)

option(
    'NSM_DUMP_OBJECT_WAIT_TIMEOUT_SEC',
    type: 'integer',
    min: 1,
    value: 60,
    description: '''Seconds nsm-dump-tool waits for a device's
        com.nvidia.Dump.DebugInfo object to appear before failing the dump;
        raise it on platforms with slower NSM enumeration''',
)

option(
    'NSM_DUMP_OBJECT_WAIT_INTERVAL_SEC',
    type: 'integer',
    min: 1,
    value: 1,
    description: '''Seconds between DebugInfo re-checks while nsm-dump-tool
        waits; sets the resolution of NSM_DUMP_OBJECT_WAIT_TIMEOUT_SEC''',
)

option(
    'rot-dump-collector',
    type: 'feature',
    value: 'disabled',
    description: 'Build ROT NSM collector binary used by erot_dump.sh',
)

option(
    'ROT_DUMP_MCTP_EID_CSV_PATH',
    type: 'string',
    value: '/usr/share/device_mctp_eid.csv',
    description: 'Path to the MCTP EID CSV file used by the ROT dump collector',
)

option(
    'cpu-diagnostic-dump',
    type: 'feature',
    value: 'disabled',
    description: 'Tool for collecting CPU diagnostic events from SatMC (CPER Error Counters, PCIe RP Static/Performance Data)',
)

option(
    'jffs-workaround',
    type: 'feature',
    description: 'Turn on jffs workaround for core file',
)

option(
    'JFFS_SPACE_CALC_INACCURACY_OFFSET_WORKAROUND_PERCENT',
    type: 'integer',
    value: 2,
    description: '''jffs2 reported no-space-left write error despite clearly 
        showing some space left, use percent of partition *capacity* as a space 
        *available* offset, eg. 200MB partition, 2% offset, 196MB available''',
)

option(
    'DUMP_BUSNAME',
    type: 'string',
    value: 'xyz.openbmc_project.Dump.Manager',
    description: 'The D-Bus busname to own',
)

option(
    'DUMP_OBJPATH',
    type: 'string',
    value: '/xyz/openbmc_project/dump',
    description: 'The dump manager D-Bus root',
)

option(
    'BMC_DUMP_OBJPATH',
    type: 'string',
    value: '/xyz/openbmc_project/dump/bmc',
    description: 'The BMC dump manager D-Bus object path',
)

option(
    'CORE_FILE_DIR',
    type: 'string',
    value: '/var/lib/systemd/coredump',
    description: 'Directory where core dumps are placed',
)

option(
    'BMC_DUMP_OBJ_ENTRY',
    type: 'string',
    value: '/xyz/openbmc_project/dump/bmc/entry',
    description: 'The BMC dump entry D-Bus object path',
)

option(
    'BMC_DUMP_PATH',
    type: 'string',
    value: '/var/lib/logging/dumps/bmc/',
    description: 'Directory where bmc dumps are placed',
)

option(
    'SYSTEMD_PSTORE_PATH',
    type: 'string',
    value: '/var/lib/systemd/pstore/',
    description: 'Path to the systemd pstore directory',
)

option(
    'KDUMP_DUMP_PATH',
    type: 'string',
    value: '/var/emmc/user-logs/logging/dumps/kdump',
    description: 'Directory where kdump vmcore-dmesg captures are written by the capture /init',
)

option(
    'SYSTEM_DUMP_PATH',
    type: 'string',
    value: '/var/lib/logging/dumps/system/',
    description: 'Directory where system dumps are placed',
)

option(
    'BMC_DUMP_MAX_SIZE',
    type: 'integer',
    value: 200,
    description: 'Maximum size of one bmc dump in kilo bytes',
)

option(
    'BMC_DUMP_MIN_SPACE_REQD',
    type: 'integer',
    value: 20,
    description: 'Minimum space required for one bmc dump in kilo bytes',
)

option(
    'BMC_DUMP_TOTAL_SIZE',
    type: 'integer',
    value: 1024,
    description: 'Total size of the dump in kilo bytes',
)

option(
    'BMC_DUMP_MAX_LIMIT',
    type: 'integer',
    value: 0,
    description: 'Total dumps to be retained on bmc, 0 represents unlimited dumps',
)

option(
    'BMC_CORE_DUMP_MAX_LIMIT',
    type: 'integer',
    value: 5,
    description: 'Total core dumps to be retained on bmc, 0 represents unlimited dumps',
)

option(
    'KDUMP_MAX_ENTRIES_PER_BOOT',
    type: 'integer',
    value: 1,
    description: 'Defensive cap on kdump artifacts processed per boot; capture is single-slot so 1 is the production value',
)

option(
    'ELOG_ID_PERSIST_PATH',
    type: 'string',
    value: '/var/lib/logging/dumps/elogid',
    description: 'Path of file for storing elog id\'s, which have associated dumps',
)

option(
    'CLASS_VERSION',
    type: 'integer',
    value: 1,
    description: 'Class version to register with Cereal',
)

option(
    'ERROR_MAP_YAML',
    type: 'string',
    value: 'example_errors_watch.yaml',
    description: 'YAML filepath containing error object paths',
)

option(
    'host-transport',
    type: 'string',
    value: 'default',
    description: 'To specify the host dump transport protocol',
)

option(
    'nvidia-dumps-extension',
    type: 'feature',
    value: 'enabled',
    description: 'Enable Nvidia system specific dumps',
)

option(
    'openpower-dumps-extension',
    type: 'feature',
    value: 'disabled',
    description: 'Enable Open Power specific dumps',
)

option(
    'SYSTEM_DUMP_MAX_SIZE',
    type: 'integer',
    value: 500,
    description: 'Maximum size of one system dump in kilo bytes',
)

option(
    'SYSTEM_DUMP_MIN_SPACE_REQD',
    type: 'integer',
    value: 50,
    description: 'Minimum space required for one system dump in kilo bytes',
)

option(
    'SYSTEM_DUMP_TOTAL_SIZE',
    type: 'integer',
    value: 1024,
    description: 'Total size of the dump in kilo bytes',
)

option(
    'SYSTEM_DUMP_MAX_LIMIT',
    type: 'integer',
    value: 10,
    description: 'Total system dumps to be retained on bmc, 0 represents unlimited dumps',
)

option(
    'dump-rotate-config',
    type: 'feature',
    value: 'disabled',
    description: 'Enable rotate config for bmc dump',
)

option(
    'enable-elog-watch',
    type: 'feature',
    description: 'Enable elog monitoring for dump creation',
    value: 'enabled',
)

# Fault log options

option(
    'FAULTLOG_DUMP_PATH',
    type: 'string',
    value: '/var/lib/logging/dumps/faultlog/',
    description: 'Directory where fault logs are placed',
)

option(
    'FAULTLOG_DUMP_OBJPATH',
    type: 'string',
    value: '/xyz/openbmc_project/dump/faultlog',
    description: 'The fault log dump manager D-Bus object path',
)

option(
    'FAULTLOG_DUMP_OBJ_ENTRY',
    type: 'string',
    value: '/xyz/openbmc_project/dump/faultlog/entry',
    description: 'The fault log dump entry D-Bus object path',
)

option(
    'FAULTLOG_DUMP_MAX_LIMIT',
    type: 'integer',
    value: 10,
    description: 'Total fault log dumps to be retained on bmc, 0 represents unlimited dumps',
)

option(
    'FAULTLOG_DUMP_TOTAL_SIZE',
    type: 'integer',
    value: 1024,
    description: 'Total size of the dump in kilo bytes',
)

option(
    'FAULTLOG_DUMP_MIN_SPACE_REQD',
    type: 'integer',
    value: 50,
    description: 'Minimum space required for one fault log dump in kilo bytes',
)

option(
    'FAULTLOG_DUMP_MAX_SIZE',
    type: 'integer',
    value: 500,
    description: 'Maximum size of one fault log dump in kilo bytes',
)

option(
    'faultlog-dump-extension',
    type: 'feature',
    value: 'disabled',
    description: 'Enable FaultLog dump',
)

option(
    'faultlog-dump-rotation',
    type: 'feature',
    value: 'disabled',
    description: 'Rotate dump when total size of dumps exceed the quota',
)

option(
    'CPER_DUMP_BIN_PATH',
    type: 'string',
    value: '/usr/bin/cper_dump.sh',
    description: 'The path of cper dump script',
)

# Configurations for openpower-dump extension

# System dump options

option(
    'SYSTEM_DUMP_OBJPATH',
    type: 'string',
    value: '/xyz/openbmc_project/dump/system',
    description: 'The system dump manager D-Bus object path',
)

option(
    'SYSTEM_DUMP_OBJ_ENTRY',
    type: 'string',
    value: '/xyz/openbmc_project/dump/system/entry',
    description: 'The system dump entry D-Bus object path',
)

# Retained for build compatibility: AllowableValues are now EM-driven, but
# platform bbappends may still pass this. Declared so meson setup doesn't fail.
option(
    'SYSTEM_DUMP_OEM_DIAGNOSTIC_ALLOWABLE_TYPE',
    type: 'string',
    value: '',
    description: 'OEM diagnostic data allowable type for system dump (unused; EM-driven)',
)

# Retimer debug mode options

option(
    'retimer-debug-mode',
    type: 'feature',
    value: 'disabled',
    description: 'Enable the retimer DebugMode interface and retimer dumps (platforms with a retimer FPGA, e.g. hgx, hgxb)',
)

option(
    'RETIMER_DEBUG_MODE_OBJPATH',
    type: 'string',
    value: '/xyz/openbmc_project/dump/retimer',
    description: 'The retimer Debug Mode state D-Bus object path',
)

# Resource dump options

option(
    'RESOURCE_DUMP_OBJPATH',
    type: 'string',
    value: '/xyz/openbmc_project/dump/resource',
    description: 'The resource dump manager D-Bus object path',
)

option(
    'RESOURCE_DUMP_OBJ_ENTRY',
    type: 'string',
    value: '/xyz/openbmc_project/dump/resource/entry',
    description: 'The resource dump entry D-Bus object path',
)

# FDR dump options

option(
    'FDR_DUMP_BIN_PATH',
    type: 'string',
    value: '/usr/bin/fdr_dump.sh',
    description: 'The path of FDR dump script',
)

option(
    'fdr-dump-extension',
    type: 'feature',
    value: 'disabled',
    description: 'Enable FDR dump',
)

option(
    'FDR_DUMP_OBJPATH',
    type: 'string',
    value: '/xyz/openbmc_project/dump/fdr',
    description: 'The FDR dump manager D-Bus object path',
)

option(
    'FDR_DUMP_OBJ_ENTRY',
    type: 'string',
    value: '/xyz/openbmc_project/dump/fdr/entry',
    description: 'The FDR dump entry D-Bus object path',
)

option(
    'FDR_DUMP_MAX_LIMIT',
    type: 'integer',
    value: 1,
    description: 'Total FDR dumps to be retained on bmc, 0 represents unlimited dumps',
)

option(
    'FDR_DUMP_PATH',
    type: 'string',
    value: '/var/lib/logging/dumps/fdr/',
    description: 'Directory where FDR dumps are placed',
)

option(
    'FDR_DUMP_TOTAL_SIZE',
    type: 'integer',
    value: 1024,
    description: 'Total size of the dump in kilo bytes',
)

option(
    'FDR_DUMP_MIN_SPACE_REQD',
    type: 'integer',
    value: 50,
    description: 'Minimum space required for one FDR dump in kilo bytes',
)

option(
    'FDR_DUMP_MAX_SIZE',
    type: 'integer',
    value: 500,
    description: 'Maximum size of one FDR dump in kilo bytes',
)

option(
    'fdr-dump-rotation',
    type: 'feature',
    value: 'disabled',
    description: 'Rotate dump when total size of dumps exceed the quota',
)

option(
    'dump-compression-algorithm',
    type: 'combo',
    choices: ['xz', 'gzip', 'zstd'],
    value: 'xz',
    description: 'Compression algorithm for dump archives',
)

option(
    'dump-staging-dir',
    type: 'string',
    value: '/tmp',
    description: 'Directory used by dreport to stage dump data during collection',
)
