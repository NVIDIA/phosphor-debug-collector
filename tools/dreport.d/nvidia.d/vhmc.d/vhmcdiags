#!/bin/bash
#
# config: 2 30
# @brief: vHMC-specific diagnostics
#

. $DREPORT_INCLUDE/functions

file_name="vhmc-diagnostics.log"

desc="network interface symlinks"
command="ls -l /sys/class/net"

if [ -d "/sys/class/net" ]; then
    add_cmd_output "$command" "$file_name" "$desc"
else
    log_info "No $desc data"
fi

desc="entity manager dbus tree"
command="busctl tree xyz.openbmc_project.EntityManager"

add_cmd_output "$command" "$file_name" "$desc" || true

desc="fru device dbus tree"
command="busctl tree xyz.openbmc_project.FruDevice"

add_cmd_output "$command" "$file_name" "$desc" || true

desc="device list"
command="ls -l /dev/"

add_cmd_output "$command" "$file_name" "$desc" || true

desc="i2c devices"
command="ls /dev/ | grep i2c"

add_cmd_output "$command" "$file_name" "$desc" || true

i2c_buses=$(ls /dev/ 2>/dev/null | grep "^i2c-" | sed 's/i2c-//' || true)
for bus in $i2c_buses; do
    desc="i2c bus $bus detection"
    command="i2cdetect -y $bus"

    if command -v i2cdetect > /dev/null 2>&1; then
        add_cmd_output "$command" "$file_name" "$desc" || true
    else
        log_info "i2cdetect not available"
        break
    fi
done

desc="mctp endpoints"
command="mctp-list-eps"

if command -v mctp-list-eps > /dev/null 2>&1; then
    add_cmd_output "$command" "$file_name" "$desc" || true
else
    log_info "mctp-list-eps not available"
fi
