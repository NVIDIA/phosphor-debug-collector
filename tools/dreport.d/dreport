#! /bin/bash

help=$(cat << EOF
        dreport creates an archive consisting of the following:
                * Configuration information
                * Debug information
                * A summary report
        The type parameter controls the content of the data. The generated
        archive is stored in the user specified location.

usage: dreport [OPTION]

Options:
        -n, —-name <name>     Name to be used for the archive.
                              Default name format obmcdump_<id>_<epochtime>
        -d, —-dir <directory> Archive directory to copy the compressed report.
                              Default output directory is /tmp
        -i, —-id <id>         Dump identifier to associate with the archive.
                              Identifiers include numeric characters.
                              Default dump identifier is 0
        -t, —-type <type>     Data collection type. Valid types are
                              "user", "core", "elog", "system".
                              Default type is "user" initiated.
        -p, —-path <path>     Optional contents to be included in the archive.
                              Valid paths are absolute file path or d-bus path
                              based on type parameter.
                                 -Absolute file path for "core" type.
                                 -elog d-bus object for "elog" type.
        -s, --size <size>     Maximum allowed size(in KB) of the archive.
                              Report will be truncated in case size exceeds
                              this limit. Default size is unlimited.
        -a, --args <args>     Additional <key>=<value> pair argument for
                              dump plugins.
        -v, —-verbose         Increase logging verbosity.
        -q, —-quiet           Only log fatal errors to stderr
        -h, —-help            Display this help and exit.
EOF
)

#CONSTANTS
declare -rx TRUE=1
declare -rx FALSE=0
declare -rx UNLIMITED="unlimited"
declare -rx SUMMARY_DUMP="summary"
declare -rx TYPE_USER="user"
declare -rx TYPE_CORE="core"
declare -rx TYPE_ELOG="elog"
declare -rx TYPE_CHECKSTOP="checkstop"
declare -rx TYPE_RAMOOPS="ramoops"
declare -rx TYPE_KDUMP="kdump"
declare -rx TYPE_SYSTEM="system"
declare -rx SUMMARY_LOG="summary.log"
declare -rx DREPORT_LOG="dreport.log"
declare -rx TMP_DIR="/tmp"
EPOCHTIME=$(date +"%s")
declare -rx EPOCHTIME
declare -rx TIME_STAMP="date -u"
declare -rx PLUGIN="pl_"
declare -rx DREPORT_SOURCE="/usr/share/dreport.d"
declare -rx DREPORT_INCLUDE="$DREPORT_SOURCE/include.d"

# Total dump timeout in seconds
# Default to 2700 if not provided
BMC_DUMP_MAX_TIME_SEC=2700
# Per-plugin timeout will be calculated as half of total timeout
BMC_DUMP_PER_PLUGIN_TIMEOUT_SEC=""

declare -rx ZERO="0"
declare -rx JOURNAL_LINE_LIMIT="500"
declare -rx HEADER_EXTENSION="$DREPORT_INCLUDE/gendumpheader"

#Error Codes
declare -rx SUCCESS="0"
declare -rx INTERNAL_FAILURE="1"
declare -rx RESOURCE_UNAVAILABLE="2"

#VARIABLES
declare -x name=""
declare -x dump_dir="/tmp"
declare -x dump_id="00000000"
declare -x dump_type=$TYPE_USER
declare -x verbose=$FALSE
declare -x quiet=$FALSE
declare -x dump_size="unlimited"
declare -x name_dir=""
declare -x optional_path=""
declare -a plugin_args=()
declare -x dreport_log=""
declare -x summary_log=""
declare -x cur_dump_size=0
declare -x pid=$ZERO
declare -x elog_id=""

#Source dreport common functions
# shellcheck source=tools/dreport.d/include.d/functions
. "$DREPORT_INCLUDE"/functions
. "$DREPORT_INCLUDE"/functions_fallback_dump

function cleanup_on_termination()
{
    echo "SIGTERM captured - cleanup $name_dir and ${name_dir}.${ARCHIVE_EXT} leftovers"
    rm -rf "$name_dir"
    rm -f "${name_dir}.${ARCHIVE_EXT}"
    exit 1
}

trap 'cleanup_on_termination' SIGTERM

# @brief Initiate data collection based on the type.
# @return 0 on success, error code otherwise
function collect_data()
{
    case $dump_type in
        "$TYPE_USER")
            ;;
        "$TYPE_CORE")
            log_summary "Core: $optional_path"
            set_core_pid
            ;;
        "$TYPE_RAMOOPS")
            log_summary "Ramoops: $optional_path"
            ;;
        "$TYPE_KDUMP")
            log_summary "Kdump: $optional_path"
            ;;
        "$TYPE_ELOG")
            log_summary "ELOG: $optional_path"
            elog_id=$(basename "$optional_path")
            set_elog_pid
            ;;
        "$TYPE_CHECKSTOP")
            log_summary "CHECKSTOP: $optional_path"
            elog_id=$(basename "$optional_path")
            set_elog_pid
            ;;
        "$TYPE_SYSTEM")
            ;;
        "$SUMMARY_DUMP")
            #No data collection is required.
            return
            ;;
        *) # unknown option
            log_error "Skipping: Unknown dump type: $dump_type"
            return
            ;;
    esac

    plugin_path=$DREPORT_SOURCE/$PLUGIN$dump_type.d

    # check plugin directory for this dump type?
    if [ ! -d "$plugin_path" ]; then
        log_error "$plugin_path does not exist, skipping dump collection"
        return 0
    fi

    local per_plugin_timeout=$BMC_DUMP_PER_PLUGIN_TIMEOUT_SEC

    # Maximum number of plugins to run concurrently.
    # Keeps memory and CPU usage bounded on the BMC.
    # wait -n exists only in bash 5.1+; without it, parallel scheduling breaks
    # (wait -n fails every time) and would spawn every plugin at once.
    local max_parallel=4
    local have_wait_n=1
    if ((BASH_VERSINFO[0] < 5 ||
        (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 1))); then
        max_parallel=1
        have_wait_n=0
    fi
    local running=0
    local pids=()
    local plugin_names=()
    local -A plugin_name_by_pid=()
    local -A plugin_exit_by_pid=()

    #Executes plugins based on the type, with bounded parallelism.
    #The throttling block only records exit codes; fallback dispatch is
    #deferred to a single reap pass below so each plugin is processed
    #at most once.
    for i in "$plugin_path"/* ; do
        # Execute plugin with timeout in background
        if [ ${#plugin_args[@]} -ne 0 ]; then
            timeout "$per_plugin_timeout" "$i" "${plugin_args[@]}" &
        else
            timeout "$per_plugin_timeout" "$i" &
        fi
        pids+=("$!")
        plugin_names+=("${i##*/}")
        plugin_name_by_pid["$!"]="${i##*/}"
        running=$((running + 1))

        # When we hit the parallel limit, wait for any one to finish.
        # Always decrement: wait -n returns the finished job's exit status,
        # so a non-zero return (timeout, plugin failure) still means one
        # slot freed up. Gating on success would stall the loop.
        if [ $running -ge $max_parallel ]; then
            if [ "$have_wait_n" -eq 1 ]; then
                local done_pid=""
                wait -n -p done_pid 2>/dev/null
                local done_rc=$?
                if [ -n "$done_pid" ]; then
                    plugin_exit_by_pid["$done_pid"]=$done_rc
                fi
            else
                # Bash < 5.1: no wait -n; wait for the job we just started
                wait "$!" 2>/dev/null
                plugin_exit_by_pid["$!"]=$?
            fi
            running=$((running - 1))
        fi
    done

    # Final reap pass: collect any remaining exit codes and dispatch
    # generate_fallback_dump exactly once per plugin for timeouts.
    # GNU timeout returns 124 when it sends SIGTERM and the child exits
    # cleanly, or 143 (128 + SIGTERM=15) when the child is killed by
    # SIGTERM without trapping it; treat both as timeouts.
    for idx in "${!pids[@]}"; do
        local pid="${pids[$idx]}"
        if [ -z "${plugin_exit_by_pid[$pid]+x}" ]; then
            wait "$pid" 2>/dev/null
            plugin_exit_by_pid["$pid"]=$?
        fi
        local exit_code="${plugin_exit_by_pid[$pid]}"
        if [ "$exit_code" -eq 124 ] || [ "$exit_code" -eq 143 ]; then
            generate_fallback_dump "${plugin_names[$idx]}" "$per_plugin_timeout"
        fi
    done
}

# @brief set pid by reading information from the optional path.
#        dreport "core" type user provides core file as optional path parameter.
#        As per coredump source code systemd-coredump uses below format
#        https://github.com/systemd/systemd/blob/master/src/coredump/coredump.c
#        /var/lib/systemd/coredump/core.%s.%s." SD_ID128_FORMAT_STR “.
#        <process ID>.%s000000"
function set_core_pid()
{
    #Escape bash characters in file name
    file=$(printf %q "$optional_path")

    #matching systemd-coredump core file format.
    pid=$(echo "$file" | awk -F . '{ print $5}')
}

# @brief set elog pid by reading _PID information from the elog d-bus object.
#        _PID information is stored  elog Additional data field
#        Data format  "_PID=<pid>"
function set_elog_pid()
{
    additional_data=$(busctl get-property xyz.openbmc_project.Logging \
            "$optional_path" \
            xyz.openbmc_project.Logging.Entry \
        AdditionalData)

    #read _PID data.
    if [ -n "$additional_data" ]; then
        pid=$(echo "$additional_data" | \
            awk -F _PID= '{ print ($2+0)}')
    fi
}

# @brief Initial version of the summary log
function init_summary()
{
    log_summary "Name:          $name.$ARCHIVE_EXT"
    log_summary "Epochtime:     $EPOCHTIME"
    log_summary "ID:            $dump_id"
    log_summary "Type:          $dump_type"
}

# @brief Check the validity of user inputs and initialize global
#        variables. Create directory for temporary data collection
# @return 0 on success, error code otherwise

function initialize()
{
    #Dump file name
    if [ -z "$name" ]; then
        name=$"obmcdump_"$dump_id"_$EPOCHTIME"
    fi

    #Create temporary data directory.
    if ! mkdir -p "$TMP_DIR/$name"; then
        echo "Error: Failed to create the temporary directory."
        return $RESOURCE_UNAVAILABLE;
    fi

    #name directory
    name_dir="$TMP_DIR/$name"

    #dreport log file
    dreport_log="$name_dir/$DREPORT_LOG"

    #summary log file
    summary_log="$name_dir/$SUMMARY_LOG"

    #Type
    if [[ ! ($dump_type = $TYPE_USER || \
             $dump_type = $TYPE_CORE || \
             $dump_type = $TYPE_ELOG || \
             $dump_type = $TYPE_RAMOOPS || \
             $dump_type = $TYPE_KDUMP || \
             $dump_type = $TYPE_SYSTEM || \
             $dump_type = $TYPE_CHECKSTOP) ]]; then
       log_error "Invalid -type, Only summary log is available"
       dump_type=$SUMMARY_DUMP
    fi

    #Size
    #Check the input is integer.
    if [ "$dump_size" -eq "$dump_size" ] 2>/dev/null; then
        #Converts in to bytes.
        dump_size="$((dump_size * 1024))"
    else
        dump_size=$UNLIMITED
    fi

    return $SUCCESS
}

# @brief Packaging the dump and transferring to dump location.
function package()
{
    if ! mkdir -p "$dump_dir"; then
        log_error "Could not create the destination directory $dump_dir"
        dump_dir=$TMP_DIR
    fi

    #Generate dump header first (if needed) so it can be prepended
    #without re-reading the entire compressed archive. The header script
    #writes to a predictable path in /tmp, so validate the result before
    #trusting it: reject symlinks (could redirect writes), non-regular
    #files, files not owned by the current user, and unreadable/empty
    #files.
    local header_file=""
    if [ -f "$HEADER_EXTENSION" ]; then
        echo "Adding Dump Header: $HEADER_EXTENSION"
        if ! "$HEADER_EXTENSION"; then
            log_error "Dump header script failed: $HEADER_EXTENSION"
        else
            header_file="/tmp/dumpheader_$EPOCHTIME"
            if [ -L "$header_file" ] || [ ! -f "$header_file" ] ||
                [ ! -O "$header_file" ] || [ ! -r "$header_file" ] ||
                [ ! -s "$header_file" ]; then
                log_error "Dump header missing, invalid, or unsafe: $header_file"
                rm -f "$header_file"
                header_file=""
            fi
        fi
    fi

    #tar and compress the files. Capture the archive exit status in
    #archive_rc immediately after the tar/zstd invocation so subsequent
    #commands (e.g. rm -f of the header file) don't clobber $?.
    local archive_rc=0
    if [ -n "$header_file" ] && [ -f "$header_file" ]; then
        # Stream header + compressed data in one pass, avoiding a re-read
        # of the entire compressed archive that prepending would otherwise
        # require. Use a subshell with pipefail so tar failures propagate
        # through the pipe to zstd; otherwise the pipe's exit status would
        # be zstd's and a tar error producing truncated output would slip
        # past the check below.
        local archive="${name_dir}.${ARCHIVE_EXT}"
        case "${DUMP_COMPRESSION:-xz}" in
            zstd)
                (
                    set -o pipefail
                    { cat "$header_file"; tar -cf - -C \
                        "$(dirname "$name_dir")" "$(basename "$name_dir")" | zstd; } > "$archive"
                )
                archive_rc=$?
                ;;
            *)
                { cat "$header_file"; tar ${TAR_COMPRESS_FLAG} -cf - -C \
                    "$(dirname "$name_dir")" "$(basename "$name_dir")"; } > "$archive"
                archive_rc=$?
                ;;
        esac
        rm -f "$header_file"
        ARCHIVE_PATH="$archive"
    else
        create_archive "$name_dir" "$(dirname "$name_dir")" "$(basename "$name_dir")"
        archive_rc=$?
    fi

    if [ $archive_rc -ne 0 ]; then
        echo "$($TIME_STAMP)" "Could not create the compressed tar file"
        rm -r "$name_dir"
        return $INTERNAL_FAILURE
    fi

    #remove the temporary name specific directory
    rm -r "$name_dir"

    echo "$($TIME_STAMP)" "Report is available in $dump_dir"

    if [ "$TMP_DIR" == "$dump_dir" ] || [ "$TMP_DIR/" == "$dump_dir" ]; then
        return $SUCCESS
    fi

    #copy the compressed tar file into the destination
    if ! cp "$ARCHIVE_PATH" "$dump_dir"; then
        echo "Failed to copy the $ARCHIVE_PATH to $dump_dir"
        rm "$ARCHIVE_PATH"
        return $INTERNAL_FAILURE
    fi

    #Remove the temporary copy of the file
    rm "$ARCHIVE_PATH"
}

# @brief Main function
function main()
{
    #initialize the global variables and
    #create temporary storage locations
    initialize
    result=$?
    if [[ ${result} -ne $SUCCESS ]]; then
        echo "$($TIME_STAMP)" "Error: Failed to initialize, Exiting"
        exit;
    fi

    #Initialize the summary log
    init_summary

    #collect data based on the type.
    collect_data

    package  #package the dump
    result=$?
    if [[ ${result} -ne $SUCCESS ]]; then
        echo "$($TIME_STAMP)" "Error: Failed to package, Exiting"
        return 1
    else
        echo "$($TIME_STAMP)" "Successfully completed"
        exit;
    fi
}

TEMP=$(getopt -o n:d:i:t:s:p:a:T:vqh \
        --long name:,dir:,dumpid:,type:,size:,path:,args:,timeout:,verbose,quiet,help \
    -- "$@")

# shellcheck disable=SC2181
# Common getopt usage, check exit status after capturing output
if [ $? -ne 0 ]
then
    echo "Error: Invalid options"
    exit 1
fi

eval set -- "$TEMP"

while [[ $# -gt 1 ]]; do
    key="$1"
    case $key in
        -n|--name)
            name=$2
            shift 2 ;;
        -d|--dir)
            dump_dir=$2
            shift 2 ;;
        -i|--dumpid)
            dump_id=$2
            shift 2 ;;
        -t|--type)
            dump_type=$2
            shift 2 ;;
        -s|--size)
            dump_size=$2
            shift 2 ;;
        -p|--path)
            optional_path=$2
            shift 2;;
        -a|--args)
            if [[ $2 == *"="* ]]; then
                k=$(echo $2 | cut -f1 -d=)
                v=$(echo $2 | cut -f2 -d=)
                plugin_args=( "${plugin_args[@]}" "$v" )
            fi
            shift 2;;
        -T|--timeout)
            BMC_DUMP_MAX_TIME_SEC=$2
            shift 2 ;;
        -v|--verbose)
            verbose=$TRUE
            shift ;;
        -q|--quiet)
            quiet=$TRUE
            shift ;;
        -h|--help)
            echo "$help"
            exit ;;
        *) # unknown option
            log_error "Unknown argument: $1"
            log_info "$help"
            exit 1 ;;
    esac
done

# Calculate per-plugin timeout as half of total timeout
BMC_DUMP_PER_PLUGIN_TIMEOUT_SEC=$((BMC_DUMP_MAX_TIME_SEC / 2))

main #main program
exit $?
