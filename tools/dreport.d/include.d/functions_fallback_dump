#!/bin/bash

# Fallback dump collection when a main plugin times out
# Called from dreport when plugin exits with code 124 (GNU timeout sent
# SIGTERM and child exited cleanly) or 143 (128 + SIGTERM, child killed
# without trapping).

function generate_fallback_dump()
{
    local plugin_name=$1
    local per_plugin_timeout=$2
    
    log_warning "Plugin $plugin_name timed out after ${per_plugin_timeout}s - running fallback"

    local fallback_plugins=("journal" "dmesginfo")
    local fallback_success=0
    local fallback_failed=0
    
    for plugin in "${fallback_plugins[@]}"; do
        local plugin_path="$DREPORT_SOURCE/plugins.d/$plugin"
        
        if [ ! -f "$plugin_path" ]; then
            log_warning "Fallback plugin $plugin not found at $plugin_path"
            continue
        fi
        
        # Execute fallback plugin
        "$plugin_path" >> "$dreport_log" 2>&1
        local exit_code=$?
        
        if [ $exit_code -eq 0 ]; then
            log_info "Fallback plugin $plugin completed successfully"
            fallback_success=$((fallback_success + 1))
        else
            log_warning "Fallback plugin $plugin failed (exit: $exit_code)"
            fallback_failed=$((fallback_failed + 1))
        fi
    done
    
    log_info "Fallback dump completed ($fallback_success success, $fallback_failed failed)"
    return 0
}
