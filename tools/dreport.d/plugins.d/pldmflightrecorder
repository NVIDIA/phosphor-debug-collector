#!/bin/bash
#
# config: 2 20
# @brief: Get the pldm flight recorder
#

# shellcheck source=tools/dreport.d/include.d/functions
. "$DREPORT_INCLUDE"/functions

desc="pldm flight recorder"

# collect data only if pldmd is enabled
if [ -e "/usr/bin/pldmd" ]; then
    # Signal pldmd to flush the flight recorder, then poll for the file.
    # A simple "exists and non-empty" check can race with pldmd still
    # writing, so wait for the size to stabilise across two consecutive
    # polls before reading. Budget stays at ~5s like the previous fixed
    # sleep, but finishes early when the write completes quickly.
    command="rm -rf /tmp/pldm_flight_recorder; killall -s SIGUSR1 pldmd; \
           prev=-1; \
           for i in \$(seq 1 10); do \
               sz=\$(stat -c %s /tmp/pldm_flight_recorder 2>/dev/null || echo 0); \
               if [ \"\$sz\" -gt 0 ] && [ \"\$sz\" = \"\$prev\" ]; then break; fi; \
               prev=\$sz; \
               sleep 0.5; \
           done; \
           cat /tmp/pldm_flight_recorder"

    file_name="pldmflightrecorder.log"

    add_cmd_output "$command" "$file_name" "$desc"

    rm -rf /tmp/pldm_flight_recorder
else
    log_warning "skipping pldm flight recorder:  pldmd is not enabled"
fi
