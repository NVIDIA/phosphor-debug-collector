#!/bin/bash
#
# config: 7 1
# @brief: Move the kdump vmcore-dmesg file to the dreport packaging.
#

# shellcheck source=tools/dreport.d/include.d/functions
. "$DREPORT_INCLUDE/functions"

desc="Kdump vmcore-dmesg"

if [ -n "${optional_path}" ] && [ -f "${optional_path}" ]; then
    if add_copy_file "${optional_path}" "$desc"; then
        # Source file moved into the archive; remove the original from
        # eMMC so it does not re-trigger kdump-monitor on the next boot.
        rm "${optional_path}"
    fi
fi
