#!/bin/bash
#
# config: 2 20
# @brief: Get all the available elogs from BMC.
#

# shellcheck source=tools/dreport.d/include.d/functions
. "$DREPORT_INCLUDE"/functions

desc="elog"
file_name="elogall.log"

# No "busctl tree" pre-check: it walks every entry, so one erased mid-walk
# fails the whole collection. This single reply just omits it instead.
command="busctl call --verbose --no-pager \
                xyz.openbmc_project.Logging \
                /xyz/openbmc_project/logging \
                org.freedesktop.DBus.ObjectManager \
                GetManagedObjects"

add_cmd_output "$command" "$file_name" "$desc"
