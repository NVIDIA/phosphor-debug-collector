#!/bin/bash
#
# config: 24 60
# @brief: Collect Journal export log information.
#

# shellcheck source=tools/dreport.d/include.d/functions
. "$DREPORT_INCLUDE"/functions

desc="Journal export log"
file_name="journal.export.zst"
out_file="$name_dir/$file_name"
command="journalctl --namespace=* -o export"

# Export is ~4x faster than json-pretty and keeps every field. To read it:
# zstd -dc <file> | systemd-journal-remote -o d/j.journal -; journalctl -D d
if eval "$command" 2>/dev/null | zstd -q -c >"$out_file" && [ -s "$out_file" ]; then
    if check_size "$out_file"; then
        log_info "Collected $desc"
    else
        log_warning "Skipping $desc"
    fi
else
    # Fallback: collect a plain journal if streaming/compression failed, so the
    # dump still contains journal data.
    rm -f "$out_file"
    desc="Journal log"
    file_name="journal.log"
    add_cmd_output "journalctl --namespace=* || true" "$file_name" "$desc"
fi
